# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Source code & configuration files
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.dex binary
*.class binary
*.so binary
*.traineddata binary
*.keystore binary
*.jks binary
