# -------------------------------------------------------------
# NttuEclass Release Keystore Configuration Example
# -------------------------------------------------------------
# 複製此檔案並重新命名為 'keystore.properties'（已加入 .gitignore，絕不上傳）
# 並填入您的正式 Release 簽名金鑰路徑與密碼：
#
# storeFile=keystores/release.jks
# storePassword=your_store_password_here
# keyAlias=your_key_alias_here
# keyPassword=your_key_password_here
#
# 若未提供此檔案，Gradle 將自動產生未簽署的發布產物（app-release-unsigned.apk / app-release.aab），
# 可直接上傳至 Google Play Console 由 Google Play App Signing 進行雲端簽署。
# -------------------------------------------------------------

storeFile=
storePassword=
keyAlias=
keyPassword=
